{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Fish House Desktop",
  "version": "1.0.0",
  "identifier": "br.com.peixariafishhouse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fish House | PDV & ERP Desktop - Peixaria Premium",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Fish House Peixaria Premium",
    "copyright": "© 2026 Fish House Peixaria Premium. Todos os direitos reservados.",
    "category": "Business",
    "shortDescription": "PDV Comercial, Balança Toledo e Controle de Estoque Offline-First",
    "longDescription": "Fish House Desktop é a solução oficial de frente de caixa (PDV), pesagem Toledo e gestão comercial offline-first para a Peixaria Premium Fish House.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  }
}
